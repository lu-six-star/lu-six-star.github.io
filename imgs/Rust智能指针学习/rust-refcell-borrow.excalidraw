    {
      "type": "text",
      "id": "code_text",
      "x": 110,
      "y": 375,
      "width": 560,
      "height": 65,
      "text": "let c = RefCell::new(5);\n{\n    let mut m = c.borrow_mut();  // 运行时记录：正在被可变借用\n    *m += 1;                     // 修改内部值\n}",
      "originalText": "let c = RefCell::new(5);\n{\n    let mut m = c.borrow_mut();  // 运行时记录：正在被可变借用\n    *m += 1;                     // 修改内部值\n}",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300003,
      "version": 1,
      "versionNonce": 300004,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
